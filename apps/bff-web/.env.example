# Copiar a .env y rellenar. Nunca commitear .env (ver .gitignore).

# Supabase (proyecto de Sanciona Fleet)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# IA — ver ADR 0001 y ADR 0003. Proveedor: OpenRouter (openai-compatible con
# urlBase por defecto). El proveedor se cablea vía @sanciona/ai-provider.
IA_PROVEEDOR=openrouter
IA_API_KEY=
# Opcional: si se setea, debe ser la URL completa /v1/chat/completions.
# Por defecto para openrouter: https://openrouter.ai/api/v1/chat/completions
# IA_URL_BASE=
IA_MODELO_EXTRACCION=        # slug OpenRouter con soporte multimodal (PDF/imagen)
IA_MODELO_ANALISIS=          # slug OpenRouter para análisis/redacción
IA_TIMEOUT_MS=120000

# deadlines-service (Etapa 4: binding de servicio; en local, URL del Worker)
DEADLINES_SERVICE_URL=http://localhost:8787

# Correo transaccional (Resend) — capacidad nueva sin servicio asignado aún,
# ver docs/legacy/CAMBIOS-LOVABLE.md. Sin configurar en local.
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_SITE_URL=http://localhost:8080
